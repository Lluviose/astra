{
  "expo": {
    "name": "Astra",
    "slug": "astra-modern",
    "version": "2.0.0",
    "scheme": "astra-modern",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lluviose.astra.modern",
      "infoPlist": {
        "CFBundleDisplayName": "Astra",
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "web": { "bundler": "metro", "output": "single", "name": "Astra · 星图" },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      ["expo-build-properties", { "ios": { "deploymentTarget": "18.0" } }],
      ["expo-image-picker", { "photosPermission": "选择照片，为你的私人档案添加封面。", "cameraPermission": "为私人档案拍摄照片。", "microphonePermission": false }],
      ["expo-local-authentication", { "faceIDPermission": "使用面容 ID 解锁你的私人档案。" }],
      ["expo-splash-screen", { "backgroundColor": "#F7F8FA" }]
    ]
  }
}
